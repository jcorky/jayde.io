---
import SiteLayout from '../layouts/SiteLayout.astro';
import Banner from '../components/Banner.astro';
import { PAGE_META } from '../data/site';
import { graph, websiteSchema, personSchema, breadcrumbSchema } from '../data/schema';

import oceanWake from '../assets/images/ocean-wake.jpg';

const jsonLd = graph([
  websiteSchema(),
  personSchema(),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog' },
  ]),
]);
---

<SiteLayout title={PAGE_META.blog.title} description={PAGE_META.blog.description} path="/blog" jsonLd={jsonLd}>
  <Banner
    slot="banner"
    image={oceanWake}
    alt="The churning wake trailing behind a ship at sea."
    title="Blog"
    focal="50% 45%"
  />

  <div class="blog-surface">
    <div class="container section">
      <p class="blog-intro">
        This is where I collect project and port stories — notes from the terminals I work with, where the
        software I train on meets the reality of a working port.
      </p>
      <p class="blog-empty">No posts yet — check back soon.</p>
    </div>
  </div>
</SiteLayout>

<style>
  .blog-surface {
    background: var(--c-olive);
    min-height: 60vh;
  }
  .blog-intro {
    max-width: 62ch;
    margin-bottom: 1.25rem;
  }
  .blog-empty {
    color: #cfd3c3;
    font-size: var(--fs-small);
    letter-spacing: 0.02em;
  }
</style>
