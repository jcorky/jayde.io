---
import { Picture } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import Banner from '../components/Banner.astro';
import { PAGE_META } from '../data/site';

import skyline from '../assets/images/panama-skyline.jpg';
import mola from '../assets/images/mola-bg.jpg';

// Placeholder page: noindex,follow, excluded from the sitemap, and no Article
// structured data until real content exists.
---

<SiteLayout
  title={PAGE_META.panama.title}
  description={PAGE_META.panama.description}
  path="/panama"
  noindex={true}
>
  <Banner
    slot="banner"
    image={skyline}
    alt="The Panama City skyline under a heavy, clouded sky."
    title="Panama 2026"
    focal="50% 40%"
  />

  <div class="panama-wrap">
    <Picture
      src={mola}
      alt=""
      formats={['avif', 'webp']}
      widths={[768, 1200, 1600, 2000]}
      sizes="100vw"
      loading="lazy"
      class="panama-bg"
    />
    <div class="panama-panel">
      <p class="panama-status">Articles coming soon</p>
      <p class="panama-back">
        <a href="/blog">← Back to Blog</a>
      </p>
    </div>
  </div>
</SiteLayout>

<style>
  .panama-wrap {
    position: relative;
    padding: clamp(1rem, 3vw, 2rem);
    min-height: 70vh;
    display: grid;
    place-items: stretch;
    background: var(--c-black);
  }
  .panama-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .panama-panel {
    position: relative;
    z-index: 1;
    background: var(--c-panama-panel);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 1.5rem;
    padding: clamp(2.5rem, 8vw, 5rem) clamp(1.25rem, 5vw, 3rem);
    min-height: 60vh;
  }
  .panama-status {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1.25rem, 3vw, 1.7rem);
    color: var(--c-text);
    text-align: center;
  }
  .panama-back a {
    color: var(--c-text);
    font-weight: 600;
    font-size: var(--fs-small);
  }
</style>
