---
import { Image, Picture } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE, BIO_PARAGRAPHS, PAGE_META } from '../data/site';
import { graph, websiteSchema, personSchema } from '../data/schema';

import portrait from '../assets/images/portrait.jpg';
import containerShip from '../assets/images/container-ship.jpg';

const jsonLd = graph([websiteSchema(), personSchema()]);
---

<SiteLayout title={PAGE_META.home.title} description={PAGE_META.home.description} path="/" jsonLd={jsonLd}>
  <!-- 1 · Hero: Saturn + JAYDE.IO wordmark -->
  <section class="hero" aria-labelledby="site-heading">
    <video
      class="hero-video"
      poster="/media/jayde-header-poster.jpg"
      width="1920"
      height="1080"
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
    >
      <source src="/media/jayde-header.mp4" type="video/mp4" />
    </video>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-stage">
      <img
        class="hero-wordmark"
        src="/img/wordmark.png"
        width="2192"
        height="362"
        alt=""
        decoding="async"
      />
      <h1 id="site-heading" class="hero-identity">{SITE.identityLine}</h1>
    </div>
  </section>

  <!-- 2 · Action band -->
  <section class="action-band" aria-label="Explore">
    <div class="container action-grid">
      <a class="action-tile" href="/blog">
        <img class="action-icon pixelated" src="/img/flame.png" width="180" height="145" alt="" />
        <span class="action-label">Projects</span>
      </a>
      <a class="action-tile" href="/contact">
        <img class="action-icon pixelated" src="/img/heart.png" width="252" height="218" alt="" />
        <span class="action-label">Get in touch</span>
      </a>
    </div>
  </section>

  <!-- 3 · Who I Am -->
  <section class="bio section" aria-labelledby="bio-heading">
    <div class="container bio-grid">
      <div class="bio-portrait">
        <Image
          src={portrait}
          alt="Jayde Cork"
          widths={[320, 480, 640]}
          sizes="(max-width: 640px) 264px, 312px"
          loading="lazy"
          class="portrait-img"
        />
      </div>
      <div class="bio-copy">
        <h2 id="bio-heading">Who I Am</h2>
        {BIO_PARAGRAPHS.map((p) => <p>{p}</p>)}
        <p class="bio-cta">
          <a href="/resume">View resume →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- 4 · Container-ship photograph -->
  <Picture
    src={containerShip}
    alt="A container ship loaded with stacked shipping containers at a port at night."
    formats={['avif', 'webp']}
    widths={[768, 1200, 1600, 2400]}
    sizes="100vw"
    loading="lazy"
    class="ship-band"
  />
</SiteLayout>

<style>
  /* 1 · Hero — full-bleed background video with the wordmark overlaid */
  .hero {
    position: relative;
    background: var(--c-black);
    overflow: hidden;
    height: clamp(440px, 66vh, 760px);
    display: flex;
  }
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--c-black);
    z-index: 0;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0) 34%, rgba(0, 0, 0, 0.6) 100%);
  }
  .hero-stage {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1120px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .hero-wordmark {
    position: absolute;
    right: var(--gutter);
    bottom: 16%;
    width: 52%;
    height: auto;
    filter: drop-shadow(0 6px 22px rgba(0, 0, 0, 0.75));
  }
  .hero-identity {
    position: absolute;
    left: var(--gutter);
    bottom: 9%;
    margin: 0;
    font-size: clamp(0.95rem, 1.6vw, 1.35rem);
    letter-spacing: 0.14em;
    color: var(--c-text);
    font-weight: 700;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.9);
  }

  @media (max-width: 720px) {
    .hero {
      height: clamp(380px, 64vh, 600px);
    }
    .hero-stage {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: center;
      gap: 0.75rem;
      padding-bottom: clamp(1.25rem, 5vw, 2rem);
    }
    .hero-wordmark,
    .hero-identity {
      position: static;
      width: auto;
    }
    .hero-wordmark {
      width: min(88vw, 420px);
    }
    .hero-identity {
      text-align: center;
    }
  }

  /* 2 · Action band */
  .action-band {
    background: var(--c-band);
    padding-block: clamp(2.25rem, 6vw, 4.25rem);
  }
  .action-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 5vw, 4rem);
  }
  .action-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    color: var(--c-text);
    padding: 1.25rem 0.5rem;
    border-radius: var(--radius);
    transition: transform 0.15s var(--ease), background 0.15s var(--ease);
  }
  .action-tile:hover {
    background: rgba(255, 255, 255, 0.04);
    transform: translateY(-2px);
  }
  .action-icon {
    height: clamp(64px, 9vw, 96px);
    width: auto;
  }
  .action-label {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.05em;
    font-size: clamp(1.4rem, 3vw, 2.1rem);
  }

  /* 3 · Who I Am */
  .bio {
    background: var(--c-black);
  }
  .bio-grid {
    display: grid;
    grid-template-columns: minmax(200px, 312px) 1fr;
    gap: clamp(1.75rem, 5vw, 4rem);
    align-items: start;
  }
  .bio-portrait {
    position: static;
    width: 100%;
    max-width: 312px;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--c-hairline);
  }
  .bio-portrait :global(img.portrait-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .bio-copy h2 {
    font-size: var(--fs-h2);
    margin-bottom: 1.25rem;
  }
  .bio-copy p + p {
    margin-top: 1rem;
  }
  .bio-cta {
    margin-top: 1.75rem;
  }
  .bio-cta a {
    display: inline-block;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 1.05rem;
    text-decoration: none;
    border-bottom: 2px solid var(--c-pixel-yellow);
    padding-bottom: 0.15rem;
  }

  @media (max-width: 640px) {
    .bio-grid {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: left;
    }
    .bio-portrait {
      width: min(72vw, 264px);
    }
  }

  /* 4 · Ship band */
  .ship-band {
    display: block;
    width: 100%;
    height: clamp(160px, 24vw, 300px);
    object-fit: cover;
    object-position: 50% 60%;
  }
</style>

<script>
  // Play the looping header video only when motion is allowed; reduced-motion
  // users (and anyone without JS) keep the static poster frame. muted +
  // playsinline lets it start via JS without a user gesture.
  const heroVideo = document.querySelector('.hero-video');
  if (heroVideo instanceof HTMLVideoElement && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const play = () => heroVideo.play().catch(() => {});
    if (heroVideo.readyState >= 2) play();
    else heroVideo.addEventListener('loadeddata', play, { once: true });
  }
</script>
