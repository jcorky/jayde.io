---
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Canonical path, e.g. "/blog". Always without a trailing slash. */
  path: string;
  noindex?: boolean;
  /** One JSON-LD @graph document, already wrapped via schema.graph(). */
  jsonLd?: object | null;
  ogType?: string;
}

const { title, description, path, noindex = false, jsonLd = null, ogType = 'website' } = Astro.props;

const canonical = path === '/' ? `${SITE.origin}/` : `${SITE.origin}${path}`;
const ogImage = `${SITE.origin}/og.png`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="dark" />
<meta name="theme-color" content={SITE.themeColor} />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{
  noindex ? (
    <meta name="robots" content="noindex,follow" />
  ) : (
    <meta name="robots" content="index,follow,max-image-preview:large" />
  )
}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Jayde.IO — Jayde Cork, Technical Trainer" />
<meta property="og:locale" content="en_US" />

<!-- Twitter / X card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content="Jayde.IO — Jayde Cork, Technical Trainer" />

<!-- Icons -->
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
