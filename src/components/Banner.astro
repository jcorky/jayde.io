---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  title: string;
  /** CSS object-position to keep the focal point in frame, e.g. "50% 40%". */
  focal?: string;
  /** Interior banners are above the fold, so load eagerly with priority. */
  eager?: boolean;
}

const { image, alt, title, focal = '50% 50%', eager = true } = Astro.props;
---

<header class="banner">
  <Picture
    src={image}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[768, 1200, 1600, 2000]}
    sizes="100vw"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    style={`object-position:${focal}`}
    class="banner-img"
  />
  <h1 class="banner-title">{title}</h1>
</header>

<style>
  .banner {
    position: relative;
    height: var(--banner-h);
    background: var(--c-black);
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .banner-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .banner-title {
    position: relative;
    z-index: 1;
    color: var(--c-text);
    font-size: var(--fs-hero);
    text-align: center;
    padding-inline: var(--gutter);
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.55);
    margin: 0;
  }
</style>
